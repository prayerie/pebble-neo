{
  "name": "neo2",
  "author": "prayerie",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "dependencies": {
    "clay": "^2.22.3",
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Neo2",
    "uuid": "2f66276c-5beb-4f40-9df8-c93d6fd43a05",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
        "basalt", 
        "diorite", 
        "aplite"
    ], 
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "health",
      "location",
      "configurable"
    ],
    "messageKeys": [
      "TEMPERATURE",
      "CONDITIONS",
      "CONDITIONS_DESC",
      "colourScheme",
      "fahrenheit",
      "hideDotw",
      "japanese",
      "hideTemp",
      "customKey",
      "customLoc",
      "secret",
      "bwBgColor"
    ],
    "resources": {
        "media": [
            {
                "menuIcon": true, 
                "type": "png", 
                "name": "IMAGE_MENU_ICON", 
                "file": "images/icon.png"
            }, 
            {
                "type": "bitmap", 
                "name": "IMAGE_THREE_WORLDS", 
                "file": "images/worlds.png"
            }, 
            {
                "type": "bitmap", 
                "name": "IMAGE_BW_WORLD", 
                "file": "images/world.png"
            }, 
            {
                "type": "bitmap", 
                "name": "IMAGE_SPRITESHEET1", 
                "file": "images/spritesheet.png"
            },
            {
                "characterRegex": "[0-9/ ]", 
                "type": "font", 
                "name": "NOTO_14", 
                "file": "fonts/noto.ttf"
            }, 
            {
                "characterRegex": "[0-9]", 
                "type": "font", 
                "name": "DSEG_33", 
                "file": "fonts/dseg3.ttf"
            }, 
            {
                "characterRegex": "[FMSTWADEHINORTU]", 
                "type": "font", 
                "name": "DSEG_14", 
                "file": "fonts/dseg3.ttf"
            }, 
            {
                "characterRegex": "[0-9 \\?\\-]", 
                "type": "font", 
                "name": "FIVEXNINE_16", 
                "file": "fonts/fivenine.ttf"
            }, 
            {
                "characterRegex": "[A-Za-z'! ]", 
                "type": "font", 
                "name": "HELV_10", 
                "file": "fonts/FSEX302.ttf", 
                "compatibility": "2.7"
            }, 
            {
                "characterRegex": "[A-Za-z'! 月火水木金土日]", 
                "type": "font", 
                "name": "JFDOT_12", 
                "file": "fonts/jfdot.ttf"
            }, 
            {
                "characterRegex": "[0-9]", 
                "type": "font", 
                "name": "JFDOT_8", 
                "file": "fonts/jf68.ttf"
            }
        ]
    }
  }
}
